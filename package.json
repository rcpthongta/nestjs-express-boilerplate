{
  "version": "0.0.1",
  "name": "nestjs-express-boilerplate",
  "description": "A minimal, scalable NestJS boilerplate for building production-ready backend applications with Express.js, Webpack, and SWC.",
  "author": "rcpthongta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcpthongta/nestjs-express-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/rcpthongta/nestjs-express-boilerplate/issues"
  },
  "private": true,
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "scripts": {
    "prepare": "husky",
    "precommit": "lint-staged",
    "prepush": "npm run test:unit-coverage",
    "generate:metadata": "node ./scripts/generate-metadata.script.mjs",
    "build": "npm run generate:metadata && cross-env NODE_ENV=development nest build",
    "build:staging": "npm run generate:metadata && cross-env NODE_ENV=staging nest build",
    "build:production": "npm run generate:metadata && cross-env NODE_ENV=production nest build",
    "dev": "npm run generate:metadata && cross-env NODE_ENV=development nest start -w --env-file ./envs/.env.development",
    "dev:debug": "npm run generate:metadata && cross-env NODE_ENV=development nest start -d -w --env-file ./envs/.env.development",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit-watch": "vitest",
    "test:unit-coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest-e2e.config.mjs",
    "test:e2e-watch": "vitest --config ./vitest-e2e.config.mjs",
    "lint": "eslint **\\*.{cjs,cts,js,json,md,mjs,mts,ts,yaml,yml}",
    "lint:fix": "eslint --fix **\\*.{cjs,cts,js,json,md,mjs,mts,ts,yaml,yml}"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@rcpthongta/string-utils": "^1.0.2",
    "joi": "^18.3.0",
    "morgan": "^1.12.1",
    "nanoid": "^6.0.2",
    "nest-winston": "^2.0.0",
    "nestjs-cls": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "response-time": "^2.3.4",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@suites/di.nestjs": "^3.1.0",
    "@suites/doubles.vitest": "^3.1.0",
    "@suites/unit": "^3.1.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.0",
    "@types/response-time": "^2.3.9",
    "@types/source-map-support": "^0.5.10",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-yml": "^3.8.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5",
    "webpack": "^5.111.1"
  }
}
